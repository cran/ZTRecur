Package: ZTRecur
Type: Package
Title: Analysis for Zero-Truncated Recurrent Event Data
Version: 0.2.1
Date: 2026-10-17
Authors@R: c(
    person("Anqi A.", "Chen", email = "anqi6@ualberta.ca", role = c("aut", "cre")),
    person("X. Joan", "Hu", role = "aut"),
    person("Yi", "Xiong", role = "aut"),
    person("Rhonda J.", "Rosychuk", role = "aut")
